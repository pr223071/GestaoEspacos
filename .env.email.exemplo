# exemplo de configuraçao do envio de e-mail (paulo)
# copie esse arquivo com o nome ".env.email" e preencha (o .env.email NAO vai pro git)
# se o .env.email nao existir, o sistema roda em modo teste e salva os e-mails na pasta emails-teste

# exemplo com gmail: precisa ativar a verificaçao em 2 etapas e criar uma "senha de app"
# (conta google -> segurança -> senhas de app), NAO use a senha normal do e-mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=senha-de-app-aqui
EMAIL_FROM=SGEC <seuemail@gmail.com>
